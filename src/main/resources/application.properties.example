spring.application.name=GroovyfyMusic
server.address=0.0.0.0
server.port=${SERVER_PORT:8080}

#configuracion de segurridad a jwt

#conexion  a la base de datos (psotgreSQL)
spring.datasource.url=jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:groovifyMusic_db}
spring.datasource.username=${DB_USER:postgres}
spring.datasource.password=${DB_PASSWORD}

#configuracion de persistencias ()jpa/hbernate
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=${JPA_DDL_AUTO:update}
spring.jpa.show-sql=${JPA_SHOW_SQL:true}
spring.jpa.properties.hbernate.forwat_sql=true

#iternacionalizacion y zona horaria
spring.jpa.properties.hibernate.jdbc.time_zone=America/El_Salvador
spring.jackson.time-zone=America/El_Salvador
spring.jackson.locale=es_SV

#definir tamanios basicos
spring.servlat.multipart.max-file-size=10MB
spring.servlat.multipart.max-request-size=10MB
app.upload.dir=${UPLOAD_DIR:uploads}
server.compression.enabled=true